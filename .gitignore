# Environments and caches
.CondaPkg/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# arXiv source bundles behind the literature tables (~250 MB of LaTeX, figures, and
# archives). They stay on Judah's machine; the per-source build.py scripts need them to
# regenerate <source>_orbits.csv, which is committed. Everything downstream
# (literature.py --cached, census.py --cached, the plots, rv_data/) runs without them.
sample/raw_lit/**/src_*/
sample/raw_lit/**/src_*.gz
sample/raw_lit/**/src_*.tar
sample/raw_lit/**/arxiv_src/
sample/raw_lit/**/*.src
sample/raw_lit/**/src/

# Fit outputs (chains are large; keep only on the machine that ran them)
fits_rv/results/

# Compiled Kepler solver (built on first use by fits_rv/kepler_c.py)
fits_rv/_build/

# Large external catalogs (G23H, ~14.8 GB); downloaded by hand, never committed
/data/

# Jump RV exports and the table ingested from them: kept on Judah's machine, never pushed (stripped from history 2026-11-13)
rv_data/jump_raw/
rv_data/jump_rvs.csv

# Developer notes are never published (Judah, 2026-11-13)
DEVELOPER_NOTES.md
**/DEVELOPER_NOTES.md

# Working notes: kept locally, never published (Judah, 2026-11-13)
PLAN.md
QUESTIONS.md
CLAUDE.md
HANDOFF.md

# Run outputs stay local; keep the repo minimal (Judah, 2026-11-16)
injection/results/
validation/results/
fits_rv/results_WithLitPlanets/
sample/*_output.txt
tmp_figures/
